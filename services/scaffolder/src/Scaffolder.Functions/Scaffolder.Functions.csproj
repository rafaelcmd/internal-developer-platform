<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lambda entry points. Packaged as a class library: every handler ships in
       one deployment package and SAM picks the entry point per function with a
       Handler string of Assembly::Namespace.Type::Method. -->
  <PropertyGroup>
    <AWSProjectType>Lambda</AWSProjectType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- Trimming a handler assembly that is resolved reflectively breaks it. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Handlers expose a test-only constructor so they can be exercised
         without the Lambda runtime or a live container. -->
    <InternalsVisibleTo Include="Scaffolder.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scaffolder.Application\Scaffolder.Application.csproj" />
    <ProjectReference Include="..\Scaffolder.Infrastructure\Scaffolder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
