# ---- Build stage ----
# Must satisfy the go directive in go.mod. The official Go images set
# GOTOOLCHAIN=local, so a builder older than the directive fails the build
# instead of fetching a newer toolchain. The deploy workflow overrides this with
# the version read out of go.mod; the default is here for a bare docker build.
ARG GO_VERSION=1.26
FROM golang:${GO_VERSION}-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o internal-developer-platform-api ./cmd/server

RUN chmod +x internal-developer-platform-api

RUN mkdir -p /app/logs && chown -R 1000:1000 /app/logs

# ---- Runtime stage ----
FROM alpine:3.19

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

RUN mkdir -p /app/logs && chown -R appuser:appgroup /app/logs

COPY --from=builder /app/internal-developer-platform-api .
COPY --from=builder /app/docs ./docs

RUN chown -R appuser:appgroup ./docs

USER appuser

ENTRYPOINT ["/app/internal-developer-platform-api"]